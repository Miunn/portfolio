generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Resource {
  id    Int     @id @default(autoincrement())
  title String? @db.VarChar(100)
  description String? @db.VarChar(100)
  text String? @db.Text
  url String? @db.VarChar(255)
  tags Tag[]
}

model Tag {
  id Int @id @default(autoincrement())
  name String? @db.VarChar(100)
  resources Resource[]
}